Z380M_CREDIT="z380m-alpine by kaantcp - https://github.com/kaantcp"

# z380m-colortest - shown in a window by the desktop on its first start: three bars to see whether red and blue are swapped
bar() { # bar <colour-code> <text-colour-code> <label>
  printf '  \033[%s;%sm%s\033[0m\n' "$1" "$2" "                                          "
  printf '  \033[%s;%sm%s\033[0m\n' "$1" "$2" "$3"
  printf '  \033[%s;%sm%s\033[0m\n\n' "$1" "$2" "                                          "
}
printf '\033[2J\033[H\n'
echo "  COLOUR CHECK - each bar must look like its name"
echo
bar 41 97 "                  R E D                   "
bar 42 30 "                G R E E N                 "
bar 44 97 "                 B L U E                  "
echo "  RED looks blue and BLUE looks red?"
echo "     tap  Menu > Display > Fix colours"
echo
echo "  Colours are right, and the cursor follows your finger?"
echo "     tap  Menu > KEEP this desktop"
echo "     then close this window (button top right)"
echo
echo "  $Z380M_CREDIT"
exec sleep 100000

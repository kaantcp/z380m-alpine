! /etc/z380m/gui/Xresources - merged into the X server by session.sh
Xft.dpi: 150
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: none

XTerm*faceName: DejaVu Sans Mono
XTerm*faceSize: 11
XTerm*utf8: 1
XTerm*saveLines: 3000
XTerm*scrollBar: true
XTerm*rightScrollBar: true
XTerm*scrollbar.width: 34
XTerm*scrollTtyOutput: false
XTerm*selectToClipboard: true
XTerm*termName: xterm-256color
XTerm*cursorBlink: false
XTerm*background: #0d1117
XTerm*foreground: #e6edf3
Z380m.author: kaantcp
Z380m.url: https://github.com/kaantcp

Z380M_CREDIT="z380m-alpine by kaantcp - https://github.com/kaantcp"

# z380m-bright up|down|NUMBER - screen brightness of the tablet (the number is 16 to the maximum, usually 255)
B=/sys/class/leds/lcd-backlight
[ -w $B/brightness ] || { echo "z380m-bright: no backlight control found at $B" >&2; exit 1; }
cur=$(cat $B/brightness 2>/dev/null); max=$(cat $B/max_brightness 2>/dev/null)
max=${max:-255}; cur=${cur:-100}
case "$1" in
  up) n=$((cur+40)) ;;
  down) n=$((cur-40)) ;;
  [0-9]*) n=$1 ;;
  *) echo "usage: z380m-bright up | down | NUMBER   (now $cur of $max)"; echo "$Z380M_CREDIT"; exit 0 ;;
esac
[ "$n" -gt "$max" ] && n=$max
[ "$n" -lt 16 ] && n=16
echo "$n" > $B/brightness
echo "brightness $n of $max"
